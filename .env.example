ANTHROPIC_API_KEY=
DEEPGRAM_API_KEY=
# needs the "Text to Speech" permission
ELEVENLABS_API_KEY=
# optional; defaults to the premade "Rachel" voice
ELEVENLABS_VOICE_ID=

# Deployment only (docker-compose.prod.yml)
# Shared passcode the page asks for; leave blank locally for no gate
ACCESS_CODE=
# Hostname Caddy gets a certificate for, e.g. 203-0-113-5.sslip.io for IP 203.0.113.5
SITE_HOST=
